[Unit]
Description=widget-svc (FireWeave demo)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fireweave/widget-svc
EnvironmentFile=-/opt/fireweave/widget-svc/.env
ExecStart=/root/.bun/bin/bun run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
