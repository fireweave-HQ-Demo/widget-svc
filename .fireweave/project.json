      ".cursor/hooks/fireweave-rollout-stop.sh",
      ".cursor/skills/initialise",
      ".cursor/skills/safe-rollout",
      ".cursor/skills/safe-rollout-fast",
      ".cursor/skills/cleanup",
      ".fireweave/rollout-ready/widget-demo-feature.json",
