    "attestUrl": "https://app-server.fireweave.ai",
    "defaultEnvironment": "prod",
    "promotionEnvironment": "prod",
    "posthogProjectId": "393610",
    "environments": {
      "prod": {
        "tier": "prod",
        "posthogProjectId": "393610"
      }
