{
  "name": "demo",
  "persistence": "persistent",
  "identity": true,
  "identityUserCount": 1000,
  "apps": [
    {
      "id": "atlas",
      "kind": "pair",
      "stack": "bun+react",
      "services": [
        "atlas-api",
        "atlas-web"
      ]
    }
  ],
  "destination": "datadog",
  "exporterStatus": "healthy",
  "fireweave": {
    "instance": "prod",
    "status": "linked",
    "agentGitUrl": "https://github.com/fireweave-HQ-Demo/widget-svc",
    "agentGitBaseBranch": "main",
    "agentGitBranch": "test_validate"
  },
  "environments": [
    {
      "name": "dev",
      "bucket": "local",
      "ports": {
        "atlas-api": 18102,
        "atlas-web": 18103,
        "collector-otlp": 18104,
        "collector-status": 18105
      },
      "running": true
    },
    {
      "name": "prod",
      "bucket": "remote",
      "ports": {
        "atlas-api": 18106,
        "atlas-web": 18107,
        "collector-otlp": 18108,
        "collector-status": 18109
      },
      "running": false
    }
  ],
  "ports": {
    "atlas-api": 18102,
    "atlas-web": 18103,
    "collector-otlp": 18104,
    "collector-status": 18105
  },
  "benchVersion": "0.1.0",
  "schemaVersion": 1
}
