{
  "name": "prod_dd_bench",
  "persistence": "ephemeral",
  "identity": false,
  "identityUserCount": 0,
  "apps": [
    {
      "id": "atlas",
      "kind": "pair",
      "stack": "bun+react",
      "services": [
        "atlas-api",
        "atlas-web"
      ]
    },
    {
      "id": "lantern",
      "kind": "pair",
      "stack": "python+svelte",
      "services": [
        "lantern-api",
        "lantern-web"
      ]
    }
  ],
  "destination": "datadog",
  "exporterStatus": "healthy",
  "fireweave": {
    "instance": "prod",
    "status": "linked",
    "agentGitUrl": "https://github.com/fireweave-HQ-Demo/widget-svc.git",
    "agentGitBaseBranch": "main",
    "agentGitBranch": "bench/prod_dd_bench"
  },
  "environments": [
    {
      "name": "dev",
      "bucket": "local",
      "ports": {
        "atlas-api": 18040,
        "atlas-web": 18041,
        "lantern-api": 18042,
        "lantern-web": 18043,
        "collector-otlp": 18044,
        "collector-status": 18045
      },
      "running": true
    },
    {
      "name": "prod",
      "bucket": "remote",
      "ports": {
        "atlas-api": 18046,
        "atlas-web": 18047,
        "lantern-api": 18048,
        "lantern-web": 18049,
        "collector-otlp": 18050,
        "collector-status": 18051
      },
      "running": false
    }
  ],
  "ports": {
    "atlas-api": 18040,
    "atlas-web": 18041,
    "lantern-api": 18042,
    "lantern-web": 18043,
    "collector-otlp": 18044,
    "collector-status": 18045
  },
  "benchVersion": "0.1.0",
  "schemaVersion": 1
}
