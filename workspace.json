{
  "name": "stg_dd_bench",
  "persistence": "ephemeral",
  "identity": false,
  "identityUserCount": 0,
  "apps": [
    {
      "id": "atlas",
      "kind": "pair",
      "stack": "bun+react",
      "services": [
        "atlas-api",
        "atlas-web"
      ]
    },
    {
      "id": "lantern",
      "kind": "pair",
      "stack": "python+svelte",
      "services": [
        "lantern-api",
        "lantern-web"
      ]
    }
  ],
  "destination": "datadog",
  "exporterStatus": "healthy",
  "fireweave": {
    "instance": "staging",
    "status": "linked",
    "agentGitUrl": "https://github.com/fireweave-HQ-Demo/widget-svc.git",
    "agentGitBaseBranch": "main",
    "agentGitBranch": "bench/stg_dd_bench"
  },
  "environments": [
    {
      "name": "dev",
      "bucket": "local",
      "ports": {
        "atlas-api": 18016,
        "atlas-web": 18017,
        "lantern-api": 18018,
        "lantern-web": 18019,
        "collector-otlp": 18020,
        "collector-status": 18021
      },
      "running": true
    },
    {
      "name": "prod",
      "bucket": "remote",
      "ports": {
        "atlas-api": 18022,
        "atlas-web": 18023,
        "lantern-api": 18024,
        "lantern-web": 18025,
        "collector-otlp": 18026,
        "collector-status": 18027
      },
      "running": false
    }
  ],
  "ports": {
    "atlas-api": 18016,
    "atlas-web": 18017,
    "lantern-api": 18018,
    "lantern-web": 18019,
    "collector-otlp": 18020,
    "collector-status": 18021
  },
  "benchVersion": "0.1.0",
  "schemaVersion": 1
}
