# SDK allows plain http only on loopback. Browser hits host-published fw-server;
# atlas-api reaches the same via fw-loopback (socat → fw-server on fireweaveai-network).
# Fill FW_PROJECT_API_KEY / PUBLIC_* after fw init / initialise.
FW_ATTEST_URL=http://127.0.0.1:3001
FW_API_URL=http://127.0.0.1:3001
FW_PROJECT_API_KEY=
PUBLIC_FW_ATTEST_URL=http://127.0.0.1:3001
PUBLIC_FW_API_URL=http://127.0.0.1:3001
PUBLIC_FW_PROJECT_API_KEY=
VITE_FW_ATTEST_URL=http://127.0.0.1:3001
VITE_FW_API_URL=http://127.0.0.1:3001
VITE_FW_PROJECT_API_KEY=
